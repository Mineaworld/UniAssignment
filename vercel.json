{
    "rewrites": [
        {
            "source": "/__/auth/(.*)",
            "destination": "https://uni-assignment-f0fbe.firebaseapp.com/__/auth/$1"
        },
        {
            "source": "/((?!api/|@vite/|@react-refresh|@id/|@fs/|__vite_ping|.*\\.(?:js|mjs|css|map|json|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|eot|txt|xml|webmanifest)$).*)",
            "destination": "/index.html"
        }
    ],
    "buildCommand": "npm run build",
    "outputDirectory": "dist"
}
