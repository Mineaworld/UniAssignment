rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection - users can only access their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Subjects subcollection
      match /subjects/{subjectId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Assignments subcollection
      match /assignments/{assignmentId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Telegram links - users can only read their own link status
    match /telegramLinks/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Write should only be done by Cloud Functions, not client
      allow write: if false;
    }
    
    // Telegram link tokens - temporary tokens for secure account linking
    // Users can create tokens for themselves, but only Cloud Functions can read/delete
    match /telegramLinkTokens/{tokenId} {
      // Allow authenticated users to create tokens, but only if the token contains their UID
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      // Read and delete only allowed from server (Cloud Functions) - not client
      allow read, update, delete: if false;
    }
  }
}
