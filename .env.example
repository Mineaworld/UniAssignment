VITE_FIREBASE_API_KEY=YOUR_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=YOUR_AUTH_DOMAIN_HERE
# On custom hosting (for example Vercel), set this to your public app domain
# after proxying /__/auth/* to https://YOUR_FIREBASE_PROJECT.firebaseapp.com/__/auth/*.
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID_HERE
VITE_FIREBASE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET_HERE
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID_HERE
VITE_FIREBASE_APP_ID=YOUR_APP_ID_HERE
VITE_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID_HERE

# Vercel Serverless Functions (set in Vercel Dashboard)
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_CLIENT_EMAIL=your_service_account_email
# FIREBASE_PRIVATE_KEY=your_private_key

# Telegram Bot Configuration
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_WEBHOOK_SECRET=your_webhook_secret (set when registering webhook with Telegram)

# Cron Job Security (for /api/cron/check-deadlines)
# CRON_SECRET=your_random_secret_for_cron_authorization

# OpenRouter (for /api/chat)
# OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_HTTP_REFERER=https://your-app-domain.com
# OPENROUTER_X_TITLE=UniAssignment
# OPENROUTER_ENABLE_MODEL_CATALOG_CHECK=false
# CHAT_RATE_LIMIT_MAX_MESSAGES=30
# CHAT_RATE_LIMIT_WINDOW_MS=3600000

# Playwright E2E test account (for auth-required browser tests)
# E2E_TEST_EMAIL=your_test_user_email
# E2E_TEST_PASSWORD=your_test_user_password
